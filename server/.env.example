# Duelist ARC (server) — example environment file
#
# Copy to `server/.env` for local/dev, or set these as real environment variables in production.
# Notes:
# - If this server is publicly reachable, always set a strong JWT_SECRET.
# - If deploying a short-lived demo, consider PUBLIC_INDEXING=false.

# Core
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
DB_PATH=./data/app.db
JWT_SECRET=change-me
COOKIE_NAME=ygo_token
COOKIE_SECURE=false

# Search engines / indexing
# - true: serve robots/sitemap normally in production
# - false: disallow all via robots, hide sitemap, and emit X-Robots-Tag in production
PUBLIC_INDEXING=true

# Duel hardening toggles
# In NODE_ENV=production, DUEL_REQUIRE_AUTH defaults to true even if unset.
DUEL_REQUIRE_AUTH=
DUEL_LOCAL_ENABLED=false
DUEL_EXPOSE_JOIN_INFO=false
DUEL_EXPOSE_ROOM_PASSWORD=false

# Optional admin visibility for duel stats (header: x-duel-admin-token)
DUEL_ADMIN_TOKEN=

# EDOPro service (EDOpro-server-ts)
EDOPRO_HTTP_URL=http://127.0.0.1:7922
EDOPRO_HOST=127.0.0.1
EDOPRO_PORT=7911

# Required for Browser Duel v0 + banlist listing (local dev)
EDOPRO_SERVER_TS_ROOT=
# Optional override (points at resources/edopro)
EDOPRO_RESOURCES_ROOT=
EDOPRO_BANLIST=
EDOPRO_RULE=

# CPU duels (WindBot)
WINDBOT_EXE=
WINDBOT_CWD=

